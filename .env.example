# Copy to .env before running docker compose.
POSTGRES_USER=itbis
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=itbis
MONGODB_DB=itbis_logs

SECRET_KEY=generate-a-long-random-string-for-production
ENVIRONMENT=production
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173

FIRST_ADMIN_EMAIL=admin@itbis.io
FIRST_ADMIN_PASSWORD=Admin@12345

# Baked into the frontend bundle at build time.
VITE_API_URL=http://localhost:8000
