# ---------------------------------------------------------------------------
# Copy to .env and edit. Only the first two lines must change for a deployment.
# ---------------------------------------------------------------------------

# REQUIRED. Signs the JWTs. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-long-random-value

# REQUIRED in production. Omit entirely to use a local SQLite file instead.
DATABASE_URL=postgresql+psycopg2://itbis:change-this-password@postgres:5432/itbis

# Turns OFF the permissive localhost CORS rule. Use "production" when deployed.
ENVIRONMENT=production

# The bootstrap administrator, created only when the user table is empty.
FIRST_ADMIN_EMAIL=admin@itbis.io
FIRST_ADMIN_PASSWORD=change-this-password

# --- Only needed for a SPLIT deployment (console and API on different hosts) --
# Single-container deployments leave both of these unset: the console is served
# by the API, so it calls /api/v1 on its own origin and there is no CORS.
# BACKEND_CORS_ORIGINS=https://console.example.com
# VITE_API_URL=https://api.example.com

# --- Optional ---------------------------------------------------------------
# POSTGRES_USER=itbis
# POSTGRES_PASSWORD=change-this-password
# POSTGRES_DB=itbis
# MONGODB_URL=mongodb://mongo:27017
# MONGODB_DB=itbis_logs
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# ANOMALY_CONTAMINATION=0.035
# RISK_CRITICAL_THRESHOLD=80
# RISK_HIGH_THRESHOLD=60
# RISK_MEDIUM_THRESHOLD=35
# Probability at/above which the supervised classifier raises an anomaly.
# CLASSIFIER_THRESHOLD=0.65

# --- Optional backing services ----------------------------------------------
# Every one of these is optional. Leave a URL blank and the API uses a
# PostgreSQL or in-process equivalent instead; GET /health/services reports
# which mode each adapter is actually running in.

# Caches dashboard aggregates. Blank -> in-process TTL cache.
# REDIS_URL=redis://redis:6379/0
# CACHE_TTL_SECONDS=60

# Full-text investigation search. Blank -> PostgreSQL ILIKE.
# Start the cluster first:  docker compose --profile search up -d
# OPENSEARCH_URL=http://opensearch:9200
# SEARCH_INDEX_PREFIX=itbis

# --- Email escalation (module 11) -------------------------------------------
# Off by default: messages are logged exactly as they would have been sent, so
# the escalation path is demonstrable without a mail server. Set SMTP_ENABLED
# to true and fill in the rest to deliver for real.
# SMTP_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_FROM=insider-threat@itbis.io
# Only alerts at or above this severity are emailed: informational|low|medium|high|critical
# EMAIL_MIN_SEVERITY=high
