lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Ignore Python Virtual Environments
venv/
.venv/
env/
.env/

# Ignore Real Environment Variable Files (CRITICAL SECURITY)
.env
.env.development
.env.production
.env.local
*.env

# Ignore OS files
.DS_Store
Thumbs.db
