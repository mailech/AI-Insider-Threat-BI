# Environment & secrets
.env

# Large datasets (>100 MB exceeds GitHub push limits)
data/cert/raw/*.csv
data/cert/answers/*.csv
data/cert/*.csv
!data/cert/**/.gitkeep

# Python caches & virtualenvs
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# Frontend dependencies and Next.js build artifacts
frontend/node_modules/
frontend/.next/
frontend/out/
node_modules/
.next/

# Logs & temp
*.log
npm-debug.log*
yarn-debug.log*
cloudflared.exe
