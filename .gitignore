# ============================================================
# ITBIS — Root .gitignore
# ============================================================

# ── Environment & Secrets ───────────────────────────────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ── Python / Virtual Environments ────────────────────────────
venv/
.venv/
env/
.env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# ── Databases & Local Storage (dev artifacts) ────────────────
backend/sql_app.db
*.db
*.sqlite
*.sqlite3

# ── Node / Next.js ──────────────────────────────────────────
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
.vercel/
*.tsbuildinfo
next-env.d.ts

# ── Testing & Code Quality Caches ───────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.mypy_cache/
.ruff_cache/

# ── Package & Build Artifacts ───────────────────────────────
dist/
*.egg-info/
*.egg
.eggs/

# ── Logs & Debugging ────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# ── Operating System & Editor Metadata ──────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.sublime-project
*.sublime-workspace

# ── SSL Certificates & Keys ─────────────────────────────────
*.pem
*.key
*.cert
*.crt
