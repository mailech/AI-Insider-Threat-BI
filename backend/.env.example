# Copy to backend/.env and adjust for your machine.

# PostgreSQL connection used by the API and by initialize_data.py
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/insideriq

# Separate database used by the pytest suite
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/insideriq_test

# JWT signing
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Existing Isolation Forest service (ml-service/)
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_SECONDS=10

# Browser origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Password applied to the role accounts created by initialize_data.py
INITIAL_ACCOUNT_PASSWORD=InsiderIQ#2024
