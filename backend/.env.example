# ---- Core ----
PROJECT_NAME="Insider Threat Behavioral Intelligence System"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database (Postgres primary). Leave blank to use local SQLite ----
DATABASE_URL=postgresql+psycopg2://itbis:itbis@localhost:5432/itbis
# DATABASE_URL=sqlite:///./itbis.db

# ---- Secondary store (MongoDB, raw log archive) - optional ----
MONGODB_URL=
MONGODB_DB=itbis_logs

# ---- CORS ----
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ---- OAuth2 (Google) - optional ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/api/v1/auth/oauth/google/callback
FRONTEND_URL=http://localhost:5173

# ---- Detection tuning ----
ANOMALY_CONTAMINATION=0.035
BASELINE_MIN_EVENTS=25
RISK_CRITICAL_THRESHOLD=80
RISK_HIGH_THRESHOLD=60
RISK_MEDIUM_THRESHOLD=35

# ---- Bootstrap admin ----
FIRST_ADMIN_EMAIL=admin@itbis.io
FIRST_ADMIN_PASSWORD=Admin@12345
