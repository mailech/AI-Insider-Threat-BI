APP_NAME=Sentinel Insight API
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Primary transactional database - PostgreSQL
# Use SSL in non-local environments, e.g. ?sslmode=require
POSTGRES_DSN=postgresql+asyncpg://sentinel_app:change-me@localhost:5432/sentinel_insight

# Secondary immutable telemetry store - MongoDB
MONGODB_URI=mongodb://sentinel_ingest:change-me@localhost:27017/?authSource=sentinel_insight
MONGODB_DATABASE=sentinel_insight

# Search and analytics - choose exactly one endpoint type
SEARCH_BACKEND=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
# OPENSEARCH_URL=https://localhost:9200
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=

# Optional: only if report exports / forensic evidence are stored externally
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_REGION=
# OBJECT_STORAGE_ENDPOINT=
