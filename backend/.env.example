# ============================================================
# CYBER AI — Environment Variables Template
# Copy this template to .env for local production configuration
# ============================================================

# ── Relational Database Configuration ────────────────────────
# SQLite default: sqlite:///./cyberai.db
# PostgreSQL DSN: postgresql+psycopg2://cyberai_user:cyberai_pass@localhost:5432/cyberai_db
DATABASE_URL=sqlite:///./cyberai.db

# ── MongoDB Configuration (Behavioral Log Store) ──────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=cyberai_logs

# ── JWT Authentication Configuration ──────────────────────────
# Generate a random 256-bit key using: openssl rand -hex 32
SECRET_KEY=cyberai-secret-key-production-256bit-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Application Configuration ────────────────────────────────
APP_NAME=CYBER AI
DEBUG=False
