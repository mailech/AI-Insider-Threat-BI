# ============================================================
# ITBIS — Environment Variables (copy to .env and fill in)
# ============================================================
# DO NOT commit .env to version control.

# ── PostgreSQL (Primary relational database) ──────────────────
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://itbis_user:itbis_pass@localhost:5432/itbis_db

# ── MongoDB (Behavioural log & event store) ───────────────────
# Format: mongodb://<host>:<port>  (add credentials if auth is enabled)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=itbis_logs

# ── JWT Authentication ─────────────────────────────────────────
# Generate a strong key with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-a-256-bit-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Application ────────────────────────────────────────────────
APP_NAME=ITBIS
DEBUG=False
