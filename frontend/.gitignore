# ============================================================
# ITBIS Frontend — .gitignore  (Next.js 16 + Tailwind v4)
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ─────────────────────────────────────
/.next/
/out/
/build

# ── Environment / Secrets ────────────────────────────────────
.env
.env.*
!.env.example

# ── Testing ──────────────────────────────────────────────────
/coverage

# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo
# next-env.d.ts is auto-generated on every `next dev/build`
next-env.d.ts

# ── Debug logs ───────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Deployment ───────────────────────────────────────────────
.vercel

# ── OS / Editor ──────────────────────────────────────────────
.DS_Store
*.pem
.idea/
.vscode/settings.json

# ── Misc ─────────────────────────────────────────────────────
*.key
*.cert
